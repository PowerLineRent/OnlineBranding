    "@supabase/supabase-js": "^2.103.3",
    "bcryptjs": "^2.4.3",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
